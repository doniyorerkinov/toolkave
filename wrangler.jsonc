{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolkave",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    // Prerendered pages live at <route>/index.html. The default ("auto-trailing-slash")
    // answers /pdf/merge with a 307 to /pdf/merge/, so every canonical URL in the
    // sitemap and hreflang tags would redirect. This serves /pdf/merge directly and
    // sends the slash form back to it instead.
    "html_handling": "drop-trailing-slash"
  },
  // The Telegram bot's pending-files table. Only file identifiers and counts:
  // the photos themselves are fetched from Telegram at conversion time and
  // never written anywhere.
  "d1_databases": [
    {
      "binding": "BOT_DB",
      "database_name": "toolkave-bot",
      "database_id": "ea9d5cf4-8839-4bc7-9ad5-785020c9f163"
    }
  ],
  "routes": [
    { "pattern": "toolkave.com", "custom_domain": true },
    { "pattern": "www.toolkave.com", "custom_domain": true }
  ],
  // Keeps toolkave.<subdomain>.workers.dev alive as a fallback URL.
  // Set to false once toolkave.com is resolving everywhere you need it.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
