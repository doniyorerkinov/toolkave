# Response headers for every asset Cloudflare serves.
#
# HSTS is the half of "always HTTPS" that lives in the repo: after one visit
# over https the browser refuses to use http for a year, so a typed
# toolkave.com never leaves the machine unencrypted again. The other half -
# redirecting the very first http request - is an edge setting:
# Cloudflare dashboard > SSL/TLS > Edge Certificates > Always Use HTTPS.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # microphone=(self), not (): an empty allowlist denies the feature to the
  # page itself, and the voice recorder is a page on this site. Ads and any
  # other third-party frame are still refused.
  Permissions-Policy: geolocation=(), microphone=(self), payment=(), usb=()

# Fonts never change under the same name; the PDF font is half a megabyte.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The background-removal model and its runtime never change, and between them
# they are the largest thing the site ever asks a browser to fetch. Keep them
# for a year so the second visit costs nothing.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/onnx/*
  Cache-Control: public, max-age=31536000, immutable

# The ffmpeg core changes only when the package version does. Held for a year,
# so a second visit to any audio or video tool costs nothing. The .gz is
# unpacked in the browser, so it must be served as-is rather than re-encoded.
/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable
